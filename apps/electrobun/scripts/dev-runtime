#!/bin/sh
# Development-only runtime launcher. Release builds use the compiled dsh binary.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)
cd "$ROOT"
# Resolve the source launcher from the repository rather than the per-
# organization DSH_HOME, whose package graph intentionally contains no dev
# dependencies.
exec node --require "$ROOT/node_modules/tsx/dist/preflight.cjs" --import "$ROOT/node_modules/tsx/dist/loader.mjs" "$ROOT/apps/cli/src/bin.ts" "$@"
