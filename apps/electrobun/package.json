{
  "name": "@deepseek-ai/dsh-enterprise-desktop",
  "private": true,
  "type": "module",
  "exports": { "./gateway": "./lib/gateway-provider.js", "./session-persistence": "./lib/session-provider.js", "./sandbox": "./lib/enterprise-sandbox.js", "./plugin-verifier": "./lib/plugin-verifier.js", "./plugin-manager": "./lib/plugin-manager.js", "./plugin-loader": "./lib/plugin-loader.js" },
  "scripts": {
    "dev": "pnpm run build:frontend && pnpm run build:plugins && pnpm run dev:prepared",
    "dev:prepared": "electrobun dev",
    "build:frontend": "vite build",
    "build:native": "tsx scripts/build-native.ts",
    "build:runtime": "tsx scripts/build-runtime.ts",
    "build": "pnpm run build:frontend && pnpm run build:native && pnpm run build:runtime && electrobun build",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:runtime": "tsc -p tsconfig.runtime.json",
    "typecheck:frontend": "tsc -p frontend/tsconfig.json",
    "build:provider": "esbuild src/gateway-provider.ts --bundle --platform=node --format=esm --external:@deepseek-ai/cordis --external:@deepseek-ai/dsh-llm --external:@deepseek-ai/dsh-llm-files --external:@deepseek-ai/dsh-attachment --outfile=lib/gateway-provider.js",
    "build:persistence": "esbuild src/session-provider.ts --bundle --platform=node --format=esm --external:@deepseek-ai/cordis --external:@deepseek-ai/dsh-session --external:@deepseek-ai/dsh-session-persistence --outfile=lib/session-provider.js",
    "build:sandbox": "esbuild src/enterprise-sandbox.ts --bundle --platform=node --format=esm --external:@deepseek-ai/cordis --external:@deepseek-ai/dsh-sandbox --external:@deepseek-ai/dsh-sandbox-local --outfile=lib/enterprise-sandbox.js",
    "build:plugin-verifier": "esbuild src/plugin-verifier.ts --bundle --platform=node --format=esm --external:@deepseek-ai/dsh-enterprise-api --outfile=lib/plugin-verifier.js",
    "build:plugin-manager": "esbuild src/plugin-manager.ts --bundle --platform=node --format=esm --external:@deepseek-ai/dsh-enterprise-api --outfile=lib/plugin-manager.js",
    "build:plugin-loader": "esbuild src/plugin-loader.ts --bundle --platform=node --format=esm --external:@deepseek-ai/dsh-enterprise-api --outfile=lib/plugin-loader.js",
    "build:enterprise-client": "pnpm --filter @deepseek-ai/dsh-enterprise-client build && pnpm --filter @deepseek-ai/dsh-client-ui-enterprise-account build",
    "build:plugins": "pnpm run build:enterprise-client && pnpm run build:provider && pnpm run build:persistence && pnpm run build:sandbox && pnpm run build:plugin-verifier && pnpm run build:plugin-manager && pnpm run build:plugin-loader",
    "watch:enterprise-client": "pnpm --filter @deepseek-ai/dsh-enterprise-client watch",
    "pretest": "pnpm run build:frontend && pnpm run build:enterprise-client",
    "test": "tsx --tsconfig ../../tsconfig.base.json --test tests/*.test.ts"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "workspace:*",
    "@deepseek-ai/dsh-llm-files": "workspace:*",
    "@deepseek-ai/dsh-attachment": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "@deepseek-ai/dsh-sandbox": "workspace:*",
    "@deepseek-ai/dsh-sandbox-local": "workspace:*",
    "@deepseek-ai/dsh-enterprise-api": "workspace:*",
    "@deepseek-ai/dsh-enterprise-client": "workspace:*",
    "@deepseek-ai/dsh-client-ui-enterprise-account": "workspace:*",
    "@deepseek-ai/dsh-host-directory-picker-native": "workspace:*",
    "@deepseek-ai/dsh-client-web": "workspace:*",
    "fs-ext": "2.1.1",
    "@deepseek-ai/dsh-client-ui-theme": "workspace:*",
    "electrobun": "2.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:*",
    "esbuild": "0.25.12",
    "@types/bun": "1.4.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/node": "^22.0.0",
    "@types/fs-ext": "2.0.3",
    "@vitejs/plugin-react": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:^" }
}
