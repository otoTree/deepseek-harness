{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "rootDir": "src", "outDir": "lib",
    "declaration": true, "rewriteRelativeImportExtensions": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
