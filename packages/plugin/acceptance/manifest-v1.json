{
  "schemaVersion": 2,
  "pluginId": "enterprise.acceptance",
  "name": "Enterprise SDK acceptance",
  "version": "1.0.0",
  "targets": [
    {
      "kind": "host",
      "entry": "host/index.js",
      "compatibility": "dsh-host>=1",
      "contributions": [
        "host:tool"
      ]
    },
    {
      "kind": "client",
      "entry": "client/index.js",
      "moduleId": "@deepseek-ai/dsh-plugin-acceptance",
      "compatibility": "dsh-client>=1",
      "contributions": [
        {
          "kind": "slot",
          "id": "panel",
          "slot": "settings.section",
          "multiplicity": "one"
        },
        {
          "kind": "window",
          "id": "inspector",
          "surface": "plugin-window",
          "multiplicity": "many",
          "titleKey": "window.inspector.title",
          "shell": "minimal",
          "defaultBounds": {
            "width": 960,
            "height": 720
          }
        }
      ]
    }
  ],
  "permissions": [
    "identity.read",
    "models.text",
    "objects.read",
    "objects.write",
    "database.query",
    "cache.read",
    "cache.write"
  ],
  "resources": [
    {
      "kind": "objects",
      "quotaBytes": 10485760
    },
    {
      "kind": "database",
      "quotaBytes": 10485760
    },
    {
      "kind": "cache",
      "quotaBytes": 1048576
    }
  ],
  "sdk": {
    "minVersion": "0.1.3-alpha.1"
  },
  "migrations": [],
  "build": {
    "runtime": "node22",
    "lockfileDigest": "668eeaa49700032f5027ce4751ad2fe808e5406af220ff684ac8f2dabe616ceb"
  }
}
