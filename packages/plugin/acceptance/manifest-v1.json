{
  "schemaVersion": 1,
  "pluginId": "enterprise.acceptance",
  "name": "Enterprise SDK acceptance",
  "version": "1.0.0",
  "targets": [
    {
      "kind": "host",
      "entry": "host/index.js",
      "compatibility": "dsh-host>=1",
      "contributions": [
        "host:tool"
      ]
    },
    {
      "kind": "client",
      "entry": "client/index.js",
      "compatibility": "dsh-client>=1",
      "contributions": [
        "client:panel"
      ]
    }
  ],
  "permissions": [
    "identity.read",
    "models.text",
    "objects.read",
    "objects.write",
    "database.query",
    "cache.read",
    "cache.write"
  ],
  "resources": [
    {
      "kind": "objects",
      "quotaBytes": 10485760
    },
    {
      "kind": "database",
      "quotaBytes": 10485760
    },
    {
      "kind": "cache",
      "quotaBytes": 1048576
    }
  ],
  "sdk": {
    "minVersion": "0.1.3-alpha.1"
  },
  "migrations": [],
  "build": {
    "runtime": "node22",
    "lockfileDigest": "0e4f60f9c50f7f4f36fdecaf4233ad71dfed9fb3be1933a7e107542f7c18c949"
  }
}
